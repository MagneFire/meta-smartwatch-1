#!/bin/sh

# Use the interactive governor: ondemand (300 ms sampling, 95% threshold)
# keeps the single Cortex-A8 at 300 MHz for the first ~0.3 s of every touch
# interaction, making the UI feel sluggish. interactive ramps to 1 GHz
# within a frame or two and still idles at 300 MHz.
echo interactive > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor