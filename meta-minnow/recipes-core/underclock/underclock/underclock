#!/bin/sh

# interactive ramps the single Cortex-A8 to 1 GHz within a frame or two of
# input; ondemand sat at 300 MHz for the first ~0.3 s of every touch.
echo interactive > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor

# Aim for 50% load like stock WearOS; the default 90 lets the single core
# run nearly saturated before stepping up.
echo 50 > /sys/devices/system/cpu/cpufreq/interactive/target_loads
