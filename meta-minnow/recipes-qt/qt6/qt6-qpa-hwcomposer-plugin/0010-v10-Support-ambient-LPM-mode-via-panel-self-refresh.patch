From 75564c1b602759378901d38dc4f8f703d610072c Mon Sep 17 00:00:00 2001
From: Darrel Griet <dgriet@gmail.com>
Date: Sun, 12 Jul 2026 22:28:51 +0200
Subject: [PATCH] v10: Support ambient (LPM) mode via panel self-refresh
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Moto 360 (minnow) uses HWC API 1.0, whose HwComposerBackend_v10 had
no ambient-mode support, so it reported ambientModeSupport()=false and
mce could never engage low-power/always-on display: the screen just
blanked fully. Unlike generic HWC 1.0 devices, minnow's DSI command-mode
panel has a hardware smart-ambient self-refresh state driven through the
'interactivemode' sysfs node, which keeps the last frame visible (dimmed,
lowest fps) and retains it in panel GRAM across SoC suspend.

Advertise ambient support when that node exists, and in sleepDisplay()
switch the panel to self-refresh (interactivemode=0) instead of blanking
when ambient mode is active, restoring it (interactivemode=1) on wake.
Also deliver update requests while in ambient so the watch face can
repaint (e.g. once a minute) before the SoC suspends again.

Upstream-Status: Pending
Signed-off-by: Darrel Griët <dgriet@gmail.com>
---
 hwcomposer/hwcomposer_backend_v10.cpp | 53 +++++++++++++++++++++++++--
 hwcomposer/hwcomposer_backend_v10.h   |  1 +
 2 files changed, 51 insertions(+), 3 deletions(-)

diff --git a/hwcomposer/hwcomposer_backend_v10.cpp b/hwcomposer/hwcomposer_backend_v10.cpp
index 8b386f1..5a386a4 100644
--- a/hwcomposer/hwcomposer_backend_v10.cpp
+++ b/hwcomposer/hwcomposer_backend_v10.cpp
@@ -43,6 +43,7 @@
 
 #include <inttypes.h>
 #include <unistd.h>
+#include <fcntl.h>
 
 #include <QtCore/QCoreApplication>
 #include <qpa/qplatformwindow.h>
@@ -154,6 +155,7 @@ HwComposerBackend_v10::HwComposerBackend_v10(hw_module_t *hwc_module, hw_device_
     , hwc_numDisplays(1) // "For HWC 1.0, numDisplays will always be one."
     , m_displayOff(false)
 {
+    m_ambientMode = false;
     hwcv10_instance = this;
     hwc_device->registerProcs(hwc_device, &global_procs);
     hwc_device->eventControl(hwc_device, 0, HWC_EVENT_VSYNC, 1);
@@ -262,6 +264,37 @@ HwComposerBackend_v10::swap(EGLNativeDisplayType /*display*/, EGLSurface /*surfa
         hwc_list->retireFenceFd = -1;
     }
 }
+// On the Moto 360 (minnow) the DSI command-mode panel implements a hardware
+// smart-ambient self-refresh state exposed through the 'interactivemode' sysfs
+// node: writing 0 switches the panel to DISPLAY_AMBIENT_ON (lowest refresh
+// rate, dimmed backlight) where it keeps showing the last committed frame from
+// its own GRAM, retaining it even across SoC suspend (the panel enters ULPS).
+// Writing 1 restores DISPLAY_ENABLE. This is minnow's equivalent of the HWC2
+// DOZE_SUSPEND power mode the v11/v20 backends use for ambient mode. The node
+// only exists on this panel, so its presence also gates whether we advertise
+// ambient support at all (see ambientModeSupport()).
+#define HWC_V10_INTERACTIVEMODE_PATH \
+    "/sys/devices/platform/omapdss/display0/interactivemode"
+
+static void hwc_v10_set_panel_interactive(bool interactive)
+{
+    int fd = open(HWC_V10_INTERACTIVEMODE_PATH, O_WRONLY);
+    if (fd < 0)
+        return;
+    if (write(fd, interactive ? "1\n" : "0\n", 2) < 0)
+        qWarning("hwcomposer: failed to write %s", HWC_V10_INTERACTIVEMODE_PATH);
+    close(fd);
+}
+
+bool
+HwComposerBackend_v10::ambientModeSupport()
+{
+    // Only advertise ambient (mce low-power / always-on display) support when
+    // the panel exposes the smart-ambient control node. Other HWC 1.0 devices
+    // have no such self-refresh mode and must blank fully instead.
+    return access(HWC_V10_INTERACTIVEMODE_PATH, W_OK) == 0;
+}
+
 
 void
 HwComposerBackend_v10::sleepDisplay(bool sleep)
@@ -269,8 +302,18 @@ HwComposerBackend_v10::sleepDisplay(bool sleep)
     m_displayOff = sleep;
     if (sleep) {
         HWC_PLUGIN_EXPECT_ZERO(hwc_device->eventControl(hwc_device, 0, HWC_EVENT_VSYNC, 0));
-        HWC_PLUGIN_EXPECT_ZERO(hwc_device->blank(hwc_device, 0, 1));
-        // Enter non-interactive state after turning off the screen.
+        // Keep the HWC display asserted on in ambient mode by unblanking
+        // (blank(...,0)) rather than powering it down (blank(...,1)) -- this
+        // mirrors what the v11/v20 backends do (blank(...,0) / DOZE_SUSPEND).
+        // Simply skipping blank() leaves the display un-asserted and it gets
+        // powered off shortly after. The panel itself drops to low-power
+        // self-refresh via the PowerHAL setInteractive() call below
+        // (interactivemode=0); we also write it directly as a fallback in
+        // case the PowerHAL is unavailable.
+        HWC_PLUGIN_EXPECT_ZERO(hwc_device->blank(hwc_device, 0, m_ambientMode ? 0 : 1));
+        if (m_ambientMode)
+            hwc_v10_set_panel_interactive(false);
+// Enter non-interactive state after turning off the screen.
         if (pwr_device) {
             pwr_device->setInteractive(pwr_device, false);
         }
@@ -281,6 +324,10 @@ HwComposerBackend_v10::sleepDisplay(bool sleep)
             pwr_device->setInteractive(pwr_device, true);
         }
         HWC_PLUGIN_EXPECT_ZERO(hwc_device->blank(hwc_device, 0, 0));
+        // Restore the fully interactive panel state. Harmless no-op when we
+        // were fully blanked; switches DISPLAY_AMBIENT_ON back to
+        // DISPLAY_ENABLE when leaving ambient mode.
+        hwc_v10_set_panel_interactive(true);
         HWC_PLUGIN_EXPECT_ZERO(hwc_device->eventControl(hwc_device, 0, HWC_EVENT_VSYNC, 1));
     }
 
@@ -321,7 +368,7 @@ HwComposerBackend_v10::requestUpdate(QEglFSWindow *window)
     // the display is turned back on (see sleepDisplay). This lets the
     // compositor go idle so the SoC can actually enter deep sleep instead of
     // busy-looping the render thread on a blanked display.
-    if (m_displayOff)
+    if (m_displayOff && !m_ambientMode)
         return true;
 
     // Deliver update requests from the vsync callback (see notifyVsync), so
diff --git a/hwcomposer/hwcomposer_backend_v10.h b/hwcomposer/hwcomposer_backend_v10.h
index 0ad3e17..2027402 100644
--- a/hwcomposer/hwcomposer_backend_v10.h
+++ b/hwcomposer/hwcomposer_backend_v10.h
@@ -66,6 +66,7 @@ public:
     virtual void sleepDisplay(bool sleep);
     virtual float refreshRate();
     virtual bool requestUpdate(QEglFSWindow *window) Q_DECL_OVERRIDE;
+    virtual bool ambientModeSupport() Q_DECL_OVERRIDE;
     void notifyVsync();
     virtual bool getScreenSizes(int *width, int *height, float *physical_width, float *physical_height)
     {
-- 
